NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only Postgres connection (Supabase direct connection or local Postgres)
# Required for: pnpm db:generate, pnpm db:migrate, pnpm db:seed, runtime getDb()
# Format: postgresql://user:password@host:port/database
DATABASE_URL=

# Supabase Auth for admin dashboard (Module 18A)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Legacy temporary admin key gate — disabled by default (Module 18A replaced with Supabase Auth)
ALLOW_LEGACY_ADMIN_KEY=false
ADMIN_DASHBOARD_KEY=
# Future email/report values
RESEND_API_KEY=
POSTMARK_API_KEY=
SENDGRID_API_KEY=
# Private Supabase Storage bucket for generated report PDFs (server-only upload)
# Default when unset: assessment-reports
REPORT_STORAGE_BUCKET=
# Email delivery (Module 14 — server-only)
EMAIL_FROM=
EMAIL_PROVIDER=
VYKEN_INTERNAL_LEAD_EMAIL=
INTERNAL_NOTIFICATION_EMAIL=

# Future CTA links
BOOK_CALL_URL=
VYKEN_GUARD_URL=
VYKEN_REGISTRATION_URL=
AI_RISK_INDEX_URL=
